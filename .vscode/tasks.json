{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Make Asset",
			"group": "build",
			"dependsOn": [
				"Make: Assets",
				"Notify: success",
			],
			"dependsOrder": "sequence",
		},
		{
			"label": "Make: Assets",
			// "group": "build",
			"command": "C:/Windows/System32/cmd.exe",
			"args": [
				"//c",
				"'${workspaceFolder}\\..\\..\\UE_5.8\\Engine\\Binaries\\Win64\\UnrealEditor-Cmd.exe'",
				"'${workspaceFolder}\\${workspaceFolderBasename}.uproject'",
				"-run=FDevAssetMakerCommandlet",
				"-Maker=\"mfs\"",
			],
			"problemMatcher": "$msCompile",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}\\..\\..\\UE_5.8"
			},
		},
		{
			"label": "Notify: success",
			// "group": "build",
			"command": "powershell.exe",
			"args": [
				"-ExecutionPolicy", "Bypass",
				"-File", "'${workspaceFolder}\\Plugins\\FDev\\bin\\notify.ps1'",
				"-message", "Build success!"
			],
			"type": "shell",
		},
	]
}
