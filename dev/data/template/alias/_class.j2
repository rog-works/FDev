{%- if fullyname.startswith('App.') and fullyname.split('#')[1].count('.') == 0 -%}
	{%- if fullyname.split('#')[1] not in ['String', 'Logs', 'CoreError'] -%}
		{%- if prefix -%}
			{{ alias }}{{ env_get('app_name') }}{{ original }}
		{%- elif alias -%}
			{{ env_get('app_name') }}{{ alias }}
		{%- else -%}
			{{ env_get('app_name') }}{{ original }}
		{%- endif -%}
	{%- else -%}
		{% include('alias/_other.j2') %}
	{%- endif -%}
{%- else -%}
	{% include('alias/_other.j2') %}
{%- endif -%}
