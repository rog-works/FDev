{%- if arguments -%}
[&]() -> {{ var_type }} {
	auto l_index = {{ arguments[0] }};
	auto l_copy = {{ receiver }}[l_index];
	{{ receiver }}{{ operator }}RemoveAt(l_index);
	return l_copy;
}(){% if is_statement %};{% endif %}
{%- else -%}
{{ receiver }}{{ operator }}Pop(){% if is_statement %};{% endif %}
{%- endif -%}
